{
  "name": "chinese-proofread",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "prebuild": "mkdir -p public/wasm && cp node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.jsep.wasm node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.jsep.mjs public/wasm/",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "setup:model": "bun scripts/download-model.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:light": "playwright test e2e/extension.spec.ts",
    "test:screenshots": "playwright test e2e/screenshots.spec.ts"
  },
  "dependencies": {
    "onnxruntime-web": "^1.20.0",
    "@mozilla/readability": "^0.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.0.268",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "4",
    "@wxt-dev/module-react": "^1.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "5",
    "vitest": "^2.1.0",
    "wxt": "^0.19.15"
  },
  "overrides": {
    "@vitejs/plugin-react": "4"
  },
  "resolutions": {
    "@vitejs/plugin-react": "4"
  }
}